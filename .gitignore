# 依赖包(从网上下载的软件库,几万个文件,不需要存档;重新 npm install 即可)
node_modules/

# 用户数据:记账数据库。账本是用户私人财产,独立放在系统目录
# (C:\Users\<用户名>\AppData\Roaming\hexagram-ledger\ledger.db),不进代码历史
ledger.db
*.db
*.db.bak
*.db-wal
*.db-shm

# Electron 打包输出
release/
dist/

# 系统临时文件
.DS_Store
Thumbs.db

# 安卓工程(Gradle 自动生成,重新执行 npx cap add android / cap sync 即可)
android/
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/capacitor-cordova-android-plugins/

# 打包好的安卓 APK(体积大,不归档;需要时重新构建)
*.apk
